# 复制为 .env 后填写。.env 不进版本库。
# 细则见 docs/llm-amkr.md

# AMKR 地址。Sirius 不直接调用任何模型供应商（R9）。
AMKR_BASE_URL=http://127.0.0.1:28881

# AMKR 的本地鉴权 Key。在 AMKR WebUI 里生成，不要提交。
AMKR_API_KEY=

# 调用点模型/任务名。AMKR 配好 TASK_XXXXXX 后逐个替换。
# 未配置任务时用 unified-model（逻辑名，不是真实模型 ID，不违反 R9）。
AMKR_MODEL=unified-model

# HTTP 监听地址。Sirius 自身具备鉴权之前只能绑 127.0.0.1。
SIRIUS_ADDR=127.0.0.1:8080

# tick 时长。1 tick = 1 游戏分钟的换算只在 tick 源头做一次（R8）。
SIRIUS_TICK_INTERVAL=1s

# agent 随机种子。固定值使 30-tick 验收可复现（R3）。
SIRIUS_SEED=20240101
