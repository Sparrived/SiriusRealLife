# 复制为 .env 后填写。.env 不进版本库。
# 细则见 docs/llm-amkr.md

# AMKR 地址。Sirius 不直接调用任何模型供应商（R9）。
AMKR_BASE_URL=http://127.0.0.1:28881

# AMKR 的本地鉴权 Key。在 AMKR WebUI 里生成，不要提交。
AMKR_API_KEY=

# AMKR 容器用哪个镜像。默认取 docker-compose.yml 里锁定的 ghcr tag，
# 但该 ghcr 包目前是**私有**的，匿名拉取一律 denied（403）。
# 换来源时覆盖这里，不必改 compose 文件。例如在服务器上用 PyPI
# 现场构建（见 gitignored 的部署文档）：AMKR_IMAGE=sirius/amkr:4.1.0
AMKR_IMAGE=

# Sirius 发布到宿主机的端口，只绑回环。本机用 8080；
# 生产服务器上 8080 已被别的服务占用，那里设 18080。
SIRIUS_HOST_PORT=8080

# 调用点模型/任务名。AMKR 配好 TASK_XXXXXX 后逐个替换。
# 未配置任务时用 unified-model（逻辑名，不是真实模型 ID，不违反 R9）。
AMKR_MODEL=unified-model

# 各调用点的单独覆盖（留空则回落到 AMKR_MODEL）。
# docs/llm-amkr.md §2 建议至少分开这三处。
AMKR_TASK_DISPATCH=
AMKR_TASK_MONOLOGUE=
AMKR_TASK_TOOL_READ=

# 单次调用上限。必须 > AMKR 的 request_timeout(60s)，否则会掐死它在途的重试。
AMKR_TIMEOUT=120s

# HTTP 监听地址。Sirius 自身具备鉴权之前只能绑 127.0.0.1。
SIRIUS_ADDR=127.0.0.1:8080

# 允许绑定非回环地址。容器部署**必须**设为 1：容器里得绑 0.0.0.0，
# 否则 Docker 的端口映射转发不进容器。开启后启动时会打一条告警。
# 本机直接跑不要开这个。
# 与 docker-compose.yml 里的 ports 写法是一对：只在显式声明、
# 且端口只映射到宿主回环（127.0.0.1:8080:8080）时才安全。
SIRIUS_ALLOW_NON_LOOPBACK=

# 放行 AMKR 的宿主机运维接口（/api/logs、/api/service/*、
# /api/integrations/*、/api/tool）。容器里语义不成立，保持关闭。
# 更稳的做法是给 AMKR 加 --no-ops（见 docker-compose.yml）。
SIRIUS_ALLOW_OPS=

# HTTP Basic 鉴权。两个都填才生效，只填一个会拒绝启动——半开的鉴权比
# 没有更危险（以为配了密码，实际不校验）。
#
# 它对**整个服务**生效，包括 /amkr/ 反代（那个等同于 AMKR 的完整管理
# 权限，能读到上游 key）。想把服务挂到公网（隧道/反代），先填这两个。
# 只有 /api/v1/health 例外，方便监控与容器探针。
#
# 只绑宿主回环的本机开发不必填。
#
# 填了之后：浏览器访问任意页面会被送到 /login（登录页，不是原生弹窗），
# 登录成功下发一个 HttpOnly 会话 cookie，有效期 7 天。**这个 cookie 也是
# 单点进 /amkr/ 的前提**——浏览器导航带不上 Authorization 头，只有 cookie
# 能跟着走。curl 与脚本仍可直接用 Basic，不必先登录。
SIRIUS_AUTH_USER=
SIRIUS_AUTH_PASS=

# 前端静态目录。跑本机开发时用 web/dist；留空则不挂静态资源。
SIRIUS_STATIC_DIR=web/dist

# 日志级别：debug / info / warn / error。
SIRIUS_LOG_LEVEL=info

# tick 时长。1 tick = 1 游戏分钟的换算只在 tick 源头做一次（R8）。
SIRIUS_TICK_INTERVAL=1s

# agent 起始游戏时刻（tick 数，1 tick = 1 游戏分钟）。540 = 09:00。
SIRIUS_START_TICK=420

# 内心独白的最小间隔（tick）。这是**唯一的 LLM 成本闸门**：
# 独白由状态进入触发，而状态平均只停留几 tick，不节流等于每次转移
# 都发一次调用（按 1s/tick 折算约每天两千多次）。
# 30 = 游戏内半小时。0 = 不节流（调试用，成本很高）。
SIRIUS_MONOLOGUE_EVERY=30
